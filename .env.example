# ── Auth (required in production) ─────────────────────────────────────────
# Supabase project → Settings → API. Free tier is enough.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Comma-separated owner email(s): full access. Anyone not listed here or in PARTNER_EMAILS is refused.
ALLOWED_EMAILS=neerajb@umich.edu
# Optional: casing partners (comma-separated). They can use the library, drills and interviewer mode;
# their own sessions/stories are private to them. Only invite people studying with you.
PARTNER_EMAILS=

# Local preview only: skip sign-in when Supabase isn't configured yet.
# Ignored on Vercel (the deployed app fails closed instead). Never set this on a server others can reach.
AUTH_DEV_BYPASS=false

# ── Optional: in-app AI interviewer (Phase 3) ─────────────────────────────────
# OFF unless BOTH are set. Without them, practice via the free Claude-app handoff.
# The key is only ever used in server routes; it never reaches the browser.
ANTHROPIC_API_KEY=
MONTHLY_SPEND_CAP_USD=0        # hard monthly cap in USD, e.g. 20. 0 = in-app interviewer off

# ── News (Phase 6) ─────────────────────────────────────────────────────────
# No key needed: free public RSS feeds. For offline testing only, point this at a folder of <feed-id>.xml files:
# NEWS_FIXTURE_DIR=
